# Copy to .env if you need overrides. Defaults match docker-compose.

# Owner role (migrate/seed): postgres://ngois:ngois_dev@127.0.0.1:5433/ngois
# App role (services; RLS enforced): postgres://ngois_app:ngois_app_dev@127.0.0.1:5433/ngois
DATABASE_URL=postgres://ngois_app:ngois_app_dev@127.0.0.1:5433/ngois
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=dev-only-change-me-ngois-jwt-secret!!
JWT_ISSUER=https://auth.local.ngointelligence.io
JWT_AUDIENCE=ngois-api
NODE_ENV=development

# --- Staging-ready provider switches (optional; default = local stubs) ---
# AUTH_MODE=dev
# AUTH_MODE=oidc
# OIDC_ISSUER=https://your-idp.example
# OIDC_CLIENT_ID=
# OIDC_REDIRECT_URI=http://127.0.0.1:5173/auth/callback

