{
  "name": "ngo-intelligence-suite",
  "version": "0.1.0",
  "private": true,
  "description": "NGO Intelligence Suite — multi-tenant SaaS for humanitarian operations",
  "workspaces": [
    "backend/packages/*",
    "backend/services/*",
    "frontend"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build -w @ngois/errors -w @ngois/logging -w @ngois/config -w @ngois/rbac -w @ngois/db -w @ngois/crypto -w @ngois/audit -w @ngois/payroll-engine -w @ngois/beneficiary-dedup -w @ngois/vulnerability-score -w @ngois/k-anonymity -w @ngois/ai-redaction -w @ngois/webhook-egress -w @ngois/tenant-context -w @ngois/service-kit && npm run build -w @ngois/api-gateway -w @ngois/auth-service -w @ngois/tenant-service -w @ngois/grant-service -w @ngois/hr-payroll-service -w @ngois/reporting-service -w @ngois/beneficiary-service -w @ngois/field-data-service -w @ngois/lms-service -w @ngois/notification-service -w @ngois/analytics-service -w @ngois/ai-insights-service -w @ngois/integration-service -w @ngois/file-service -w @ngois/outbox-relay -w @ngois/webhook-dispatcher --if-present",
    "build:frontend": "npm run build -w @ngois/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx,.vue",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:payroll-fixtures": "npm run test -w @ngois/payroll-engine",
    "test:load": "node scripts/run-load-tests.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "verify:frontend": "npm run check:contrast && npm run build:frontend && npm run check:bundle && npm run check:lighthouse",
    "verify:phase1-gates": "node scripts/verify-phase1-gates.mjs",
    "verify:phase2-gates": "node scripts/verify-phase2-gates.mjs",
    "verify:phase3-gates": "node scripts/verify-phase3-gates.mjs",
    "verify:phase4-gates": "node scripts/verify-phase4-gates.mjs",
    "verify:webhooks-gates": "node scripts/verify-webhooks-gates.mjs",
    "verify:staging-ready": "node scripts/verify-staging-ready.mjs",
    "check:providers-env": "node scripts/check-providers-env.mjs",
    "verify:go-live-prep": "node scripts/verify-go-live-prep.mjs",
    "smoke:staging-checklist": "node scripts/smoke-staging-checklist.mjs",
    "dev:gateway": "npm run dev -w @ngois/api-gateway",
    "dev:auth": "npm run dev -w @ngois/auth-service",
    "dev:tenant": "npm run dev -w @ngois/tenant-service",
    "dev:grant": "npm run dev -w @ngois/grant-service",
    "dev:hr": "npm run dev -w @ngois/hr-payroll-service",
    "dev:reporting": "npm run dev -w @ngois/reporting-service",
    "dev:beneficiary": "npm run dev -w @ngois/beneficiary-service",
    "dev:field": "npm run dev -w @ngois/field-data-service",
    "dev:lms": "npm run dev -w @ngois/lms-service",
    "dev:notify": "npm run dev -w @ngois/notification-service",
    "dev:analytics": "npm run dev -w @ngois/analytics-service",
    "dev:ai": "npm run dev -w @ngois/ai-insights-service",
    "dev:integration": "npm run dev -w @ngois/integration-service",
    "dev:file": "npm run dev -w @ngois/file-service",
    "dev:outbox": "npm run dev -w @ngois/outbox-relay",
    "dev:webhooks": "npm run dev -w @ngois/webhook-dispatcher",
    "dev:backend": "npm run dev:auth",
    "stack:prod-shaped": "node scripts/stack-prod-shaped.mjs",
    "terraform:validate": "node scripts/terraform-validate.mjs",
    "drill:dr-failover": "node scripts/drill-dr-failover.mjs",
    "pen-test:selfcheck": "node scripts/pen-test-selfcheck.mjs",
    "smoke:webhooks-e2e": "node scripts/smoke-webhooks-e2e.mjs",
    "dev:frontend": "npm run dev -w @ngois/web",
    "dev:web": "npm run dev -w @ngois/web",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w @ngois/db",
    "db:seed": "npm run seed -w @ngois/db",
    "db:setup-local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-db.ps1",
    "db:provision-payroll": "node scripts/provision-payroll-schemas.mjs",
    "db:repair-app-role": "node scripts/fix-app-role.mjs",
    "db:repair-app-grants": "node scripts/fix-app-grants.mjs",
    "dev:db": "node scripts/start-embedded-db.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "smoke:payroll-e2e": "node scripts/smoke-payroll-e2e.mjs",
    "smoke:phase2-e2e": "node scripts/smoke-phase2-e2e.mjs",
    "smoke:field-e2e": "node scripts/smoke-field-e2e.mjs",
    "smoke:phase3-e2e": "node scripts/smoke-phase3-e2e.mjs",
    "smoke:paper-fallback": "node scripts/smoke-paper-fallback.mjs",
    "offline:harness": "node scripts/offline-harness.mjs",
    "load:field-2g": "node scripts/load-field-2g.mjs",
    "chaos:catalogue": "node scripts/chaos-catalogue.mjs",
    "dpia:attest:phase3": "node scripts/dpia-attest-phase3.mjs",
    "smoke:phase4-e2e": "node scripts/smoke-phase4-e2e.mjs",
    "test:ai-redaction": "node scripts/generate-redaction-corpus.mjs && npm run test -w @ngois/ai-redaction",
    "eval:ai-injection": "node scripts/eval-ai-injection.mjs",
    "finops:attribution": "node scripts/finops-attribution.mjs",
    "load:payroll-500": "node scripts/load-payroll-500.mjs",
    "drill:canary-abort": "node scripts/drill-canary-abort.mjs",
    "accountant:review-pack": "node scripts/accountant-review-pack.mjs",
    "dpia:attest": "node scripts/dpia-attest.mjs",
    "test:isolation": "node scripts/isolation-suite.mjs",
    "verify:rls": "node scripts/verify-rls.mjs",
    "verify:set-local": "node scripts/verify-set-local.mjs",
    "verify:audit": "npm run verify -w @ngois/audit",
    "verify:alerts-runbooks": "node scripts/verify-alerts-runbooks.mjs",
    "verify:platform": "node scripts/verify-platform.mjs && node scripts/verify-alerts-runbooks.mjs",
    "retention:sweep": "node scripts/retention-sweep.mjs",
    "leave:accrual": "node scripts/leave-accrual.mjs",
    "reporting:worker": "node scripts/reporting-worker.mjs",
    "drill:audit": "node scripts/drill-audit-chain.mjs",
    "drill:encryption": "node scripts/drill-encryption-sample.mjs",
    "drill:backup": "node scripts/drill-backup-restore.mjs",
    "drill:erasure": "node scripts/drill-erasure.mjs",
    "drill:rb05": "node scripts/drill-rb05-onboarding.mjs",
    "drill:rollback-local": "node scripts/drill-rollback-local.mjs",
    "drill:dr-stub": "node scripts/drill-dr-stub.mjs",
    "drill:phase1": "node scripts/drill-phase1.mjs",
    "canary:local": "node scripts/canary-local-check.mjs",
    "canary:analysis-stub": "node scripts/canary-analysis-stub.mjs",
    "ci:local": "npm run verify:set-local && npm run typecheck && npm test && npm run build:backend && npm run verify:rls && npm run test:isolation && npm run verify:phase1-gates"
  },
  "devDependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17",
    "@types/node": "^22.15.21",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "axe-core": "^4.10.3",
    "c8": "^10.1.3",
    "chrome-launcher": "^1.2.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.27.0",
    "lighthouse": "^12.8.2",
    "prettier": "^3.5.3",
    "puppeteer-core": "^25.4.0",
    "typescript": "^5.8.3"
  }
}
